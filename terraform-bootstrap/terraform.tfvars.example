github_owners     = ["your-github-owner"]
github_repository = "dambda"
state_bucket_name = "your-unique-dambda-terraform-state"

# Supply organization-approved policies that cover the resources in terraform/.
# AdministratorAccess is intentionally not used by this bootstrap.
deploy_managed_policy_arns = [
  "arn:aws:iam::aws:policy/PowerUserAccess",
  "arn:aws:iam::aws:policy/IAMFullAccess"
]
